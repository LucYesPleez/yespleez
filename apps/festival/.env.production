# Build-time configuration for production builds. COMMITTED ON PURPOSE.
#
# Nothing here is secret: the anon key ships to every browser and RLS is the
# protection, not the key; the allowlist is enforced properly by RLS on
# festival-profile creation — the client gate it feeds is UX, not security.
#
# This exists because Cloudflare Pages' "Variables and secrets" panel did not
# deliver these to the build (verified by probing the deployed bundle), and a
# committed .env.production works identically on any host. If a value here
# ever becomes secret, it moves out of the repo and this comment is the alarm.
VITE_SUPABASE_URL=https://doqzxvppibuzieajqkxm.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_Ugs2Uz9OGWx__wDzntz0SQ_bGa0uF8P
VITE_ORGANISER_ALLOWLIST=lucious.aus@gmail.com

# ⚠ WITHOUT THIS, EVERY APPLICATION LINK THE BETA HANDS OUT POINTS AT LOCALHOST.
# config/scene.js falls back to http://localhost:5174 when unset, and the link
# looks perfectly valid to whoever copies it. Missing from this file until
# 2026-08-07 — precisely the failure that file's own comment predicted.
#
# (Resolved 2026-08-26: `main` and `v2-react` converged at the monorepo
# cutover, and the deployed Scene bundle was probed and carries the festival
# apply flow. The earlier warning here about `v2-react` is history.)
VITE_SCENE_URL=https://yespleez.pages.dev

# The landing page's own public origin, baked into the links the portal hands
# out. window.location would stamp a preview deploy's hostname into whatever
# the organiser pasted it into; a copied link outlives the machine it was
# copied on. See config/landing.js.
VITE_PUBLIC_ORIGIN=https://yespleez-festival.pages.dev
